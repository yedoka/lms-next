# Database (Neon)
DATABASE_URL=

# Auth.js v5
AUTH_SECRET=
AUTH_TRUST_HOST=true
# AUTH_URL is auto-detected on Vercel; only set for custom domains or non-Vercel hosts
# AUTH_URL=

# Realtime server (skillbase-express). Must be NEXT_PUBLIC_: the socket client runs in
# the browser. Falls back to http://localhost:8080 when unset.
NEXT_PUBLIC_SOCKET_URL=

# Redis — the same instance skillbase-express uses. Redis protocol URL, not the REST
# endpoint: both apps connect with ioredis (rediss://... from the Upstash
# dashboard). Notifications and live quiz sessions break without it.
REDIS_URL=

# Cloudinary
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
NEXT_PUBLIC_CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Absolute base URL used to build password-reset links.
# Defaults to http://localhost:3000 when unset.
NEXT_PUBLIC_APP_URL=

# Optional — transactional email for password resets. Without it, reset links
# are written to the server console instead of being sent.
RESEND_API_KEY=

# Optional — sender name in those emails. Defaults to "LMS Platform".
NEXT_PUBLIC_PLATFORM_NAME=
