# One env file for the whole workspace. Copy to .env and fill in.
#
# Loaded explicitly by each package, since none of them sit at the repo root:
#   apps/web       dotenv-cli            (-e ../../.env)
#   apps/realtime  bun --env-file=../../.env
#   packages/db    packages/db/prisma.config.ts
#
# Keeping a single file is the point: apps/web and apps/realtime share one
# Postgres database and one Redis instance. Two files meant two chances to
# point them somewhere different.

# --- database ---
# Neon PostgreSQL. Both apps read it; apps/realtime also writes QuizAttempt and
# AttemptAnswer rows when a live quiz session ends.
DATABASE_URL=

# --- redis ---
# Redis protocol URL (rediss://... from the Upstash dashboard), not the REST
# endpoint — both apps connect with ioredis. They talk over pub/sub, so this
# must be one instance. Notifications and live quiz sessions break without it.
REDIS_URL=

# Optional, only if something uses the Upstash REST API.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- auth ---
# apps/realtime verifies the session JWE the browser fetches from
# /api/auth/socket-token, so it must be the same secret.
AUTH_SECRET=
AUTH_TRUST_HOST=true
# Auto-detected in most setups; set for custom domains.
AUTH_URL=

# --- cloudinary ---
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
NEXT_PUBLIC_CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_URL=

# --- apps/realtime ---
# Next.js also reads PORT, so this one value would move both servers onto the
# same port. apps/web pins itself with `next dev -p 3000` for that reason —
# leave PORT meaning "the realtime port".
PORT=8080
ENV=development
# Origin allowed by CORS — the apps/web URL.
CLIENT_URL=http://localhost:3000

# --- apps/web ---
# Where the browser opens its socket. Falls back to http://localhost:8080.
NEXT_PUBLIC_SOCKET_URL=http://localhost:8080

# Absolute base URL used to build password-reset links.
# Defaults to http://localhost:3000 when unset.
NEXT_PUBLIC_APP_URL=

# Optional — transactional email for password resets. Without it, reset links
# are written to the server console instead of being sent.
RESEND_API_KEY=

# Optional — sender name in those emails. Defaults to "Skillbase".
NEXT_PUBLIC_PLATFORM_NAME=
